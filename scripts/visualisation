library(dplyr)
library(tidyr)
library(ggplot2)
library(sf)
library(scales)
library(rnaturalearth)
library(viridis)

# 1. Europe base map

europe_raw <- ne_countries(scale = "medium", continent = "Europe", returnclass = "sf") %>%
  bind_rows(
    ne_countries(scale = "medium", country = c("Turkey", "Cyprus"), returnclass = "sf")
  ) %>%
  filter(!iso_a2 %in% c("RU", "BY")) %>%
  mutate(
    iso_a2 = if_else(iso_a2 == "-99", iso_a2_eh, iso_a2),
    iso_a2 = if_else(iso_a2 == "GB", "UK", iso_a2)
  )

bbox <- coord_sf(xlim = c(-12, 35), ylim = c(34, 72), expand = FALSE)

map_theme <- theme_void(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5, margin = margin(b = 8)),
    plot.caption = element_text(colour = "grey50", size = 8, hjust = 1),
    strip.text = element_text(face = "bold", size = 10),
    legend.position = "bottom",
    legend.key.width = unit(2.5, "cm"),
    legend.title = element_text(size = 9),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(15, 15, 15, 15)
  )

# 2. Build sent / received / net_flow from corridors
# corridors must already exist from final_country pipeline
sent <- corridors %>%
  group_by(country = send_code) %>%
  summarise(students_sent = sum(n_students), .groups = "drop")

received <- corridors %>%
  group_by(country = recv_code) %>%
  summarise(students_received = sum(n_students), .groups = "drop")

net_flow <- sent %>%
  full_join(received, by = "country") %>%
  mutate(
    students_sent = replace_na(students_sent, 0),
    students_received = replace_na(students_received, 0),
    net_flow = students_received - students_sent
  )

# 3. Net flow map

europe_net <- europe_raw %>%
  left_join(net_flow, by = c("iso_a2" = "country"))

p_net <- ggplot(europe_net) +
  geom_sf(aes(fill = net_flow), colour = "white", linewidth = 0.2) +
  scale_fill_gradient2(
    low = "#d7191c",
    mid = "#ffffbf",
    high = "#2c7bb6",
    midpoint = 0,
    name = "Net flow\n(received − sent)",
    labels = comma,
    na.value = "#e0ddd8"
  ) +
  bbox + map_theme +
  labs(
    title = "Erasmus+ Net Student Flow by Country (2014–2022)",
    caption = "Blue = net receiver | Red = net sender | Source: Erasmus+ Open Data"
  )

ggsave("erasmus_net_flow.png", p_net, dpi = 300, width = 10, height = 9)


europe_sent <- europe_raw %>%
  left_join(sent, by = c("iso_a2" = "country"))

europe_recv <- europe_raw %>%
  left_join(received, by = c("iso_a2" = "country"))

fill_scale <- function(name) {
  scale_fill_viridis_c(
    option = "plasma",
    name = name,
    trans = "log10",
    labels = comma,
    na.value = "#e0ddd8",
    breaks = c(100, 1000, 10000, 50000, 100000)
  )
}

p_sent <- ggplot(europe_sent) +
  geom_sf(aes(fill = students_sent), colour = "white", linewidth = 0.2) +
  fill_scale("Students sent") +
  bbox + map_theme +
  labs(
    title = "Erasmus+ Students Sent Abroad (2014–2022)",
    caption = "Source: Erasmus+ Open Data | Log scale"
  )

ggsave("erasmus_choropleth_sent.png", p_sent, dpi = 300, width = 10, height = 9)

p_recv <- ggplot(europe_recv) +
  geom_sf(aes(fill = students_received), colour = "white", linewidth = 0.2) +
  fill_scale("Students received") +
  bbox + map_theme +
  labs(
    title = "Erasmus+ Students Received (2014–2022)",
    caption = "Source: Erasmus+ Open Data | Log scale"
  )

ggsave("erasmus_choropleth_received.png", p_recv, dpi = 300, width = 10, height = 9)


# 5. Top 15 corridor arrows map
# Uses centroid coordinates already in corridors:
# lon_from, lat_from, lon_to, lat_to

flows_top15 <- corridors %>%
  group_by(send_code, recv_code) %>%
  summarise(
    n_students = sum(n_students),
    lon_from = first(lon_from),
    lat_from = first(lat_from),
    lon_to = first(lon_to),
    lat_to = first(lat_to),
    .groups = "drop"
  ) %>%
  slice_max(n_students, n = 15) %>%
  mutate(curve = if_else(send_code < recv_code, 0.2, -0.2))

p_top15 <- ggplot() +
  geom_sf(data = europe_raw, fill = "#f0ede8", colour = "#cccccc", linewidth = 0.3) +
  geom_curve(
    data = flows_top15 %>% filter(curve > 0),
    aes(x = lon_from, y = lat_from, xend = lon_to, yend = lat_to,
        linewidth = n_students, colour = n_students),
    curvature = 0.2,
    alpha = 0.85,
    arrow = arrow(length = unit(0.25, "cm"), type = "closed")
  ) +
  geom_curve(
    data = flows_top15 %>% filter(curve < 0),
    aes(x = lon_from, y = lat_from, xend = lon_to, yend = lat_to,
        linewidth = n_students, colour = n_students),
    curvature = -0.2,
    alpha = 0.85,
    arrow = arrow(length = unit(0.25, "cm"), type = "closed")
  ) +
  scale_colour_viridis_c(
    option = "plasma",
    name = "Students",
    labels = comma,
    trans = "log10"
  ) +
  scale_linewidth_continuous(range = c(0.8, 4.5), guide = "none") +
  bbox +
  theme_void(base_size = 11) +
  theme(
    legend.position = "bottom",
    legend.key.width = unit(2.5, "cm"),
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
    plot.caption = element_text(colour = "grey50", size = 8, hjust = 1),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(15, 15, 15, 15)
  ) +
  labs(
    title = "Top 15 Erasmus+ Corridors (2014–2022)",
    caption = "Source: Erasmus+ Open Data"
  )

ggsave("erasmus_top15_arrows.png", p_top15, dpi = 300, width = 10, height = 10)

# 6. Distance bands by period

corridors_distcat <- corridors %>%
  mutate(
    dist_cat = case_when(
      distance_km <= 1000 ~ "short",
      distance_km <= 2500 ~ "medium",
      TRUE ~ "long"
    ),
    period = factor(period, levels = c("early", "pre_covid", "covid", "post_covid"))
  )

flows_by_period_dist <- corridors_distcat %>%
  group_by(period, dist_cat) %>%
  summarise(total = sum(n_students), .groups = "drop") %>%
  group_by(period) %>%
  mutate(share = total / sum(total)) %>%
  ungroup()

p_bands <- ggplot(flows_by_period_dist, aes(x = period, y = share, fill = dist_cat)) +
  geom_col(position = "fill") +
  scale_y_continuous(labels = percent_format(accuracy = 1)) +
  scale_fill_viridis_d(name = "Distance band") +
  theme_minimal(base_size = 11) +
  labs(
    title = "Share of Flows by Distance Band and Period",
    x = NULL,
    y = "Share of flows"
  )

ggsave("erasmus_flows_distance_bands_period.png", p_bands, dpi = 300, width = 8, height = 5)

# 7. Top-10 concentration by period
top10_share <- corridors %>%
  group_by(period, send_code, recv_code) %>%
  summarise(n = sum(n_students), .groups = "drop") %>%
  group_by(period) %>%
  mutate(rank = rank(-n, ties.method = "first")) %>%
  summarise(
    total_all = sum(n),
    top10_total = sum(n[rank <= 10]),
    top10_share = top10_total / total_all,
    .groups = "drop"
  ) %>%
  mutate(period = factor(period, levels = c("early", "pre_covid", "covid", "post_covid")))

p_top10 <- ggplot(top10_share, aes(x = period, y = top10_share, group = 1)) +
  geom_line(linewidth = 1, colour = "#d7191c") +
  geom_point(size = 3, colour = "#d7191c") +
  scale_y_continuous(labels = percent_format(accuracy = 1), limits = c(0, NA)) +
  theme_minimal(base_size = 11) +
  labs(
    title = "Top-10 Corridor Share of Total Flows by Period",
    x = NULL,
    y = "Share of total flows"
  )

ggsave("erasmus_top10_share_period.png", p_top10, dpi = 300, width = 8, height = 5)
